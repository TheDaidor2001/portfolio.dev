---
import HeadingText from "../HeadingText.astro";
import Logo from "../Logo.astro";
import Link from "../icons/Link.astro";

const EXPERIENCE = [
    {
        nombre: "Freelance",
        puesto: "Web Developer",
        duration: "Jun 2024 - Today",
        current: true,
        description:
            "I design and build custom websites end to end: I talk to the client, define the interface, develop it and ship it. Fast, responsive sites built to rank and convert.",
        highlights: ["Astro", "Next.js", "Tailwind", "SEO"],
        url: "https://github.com/TheDaidor2001",
        logo: null,
        icon: Logo,
        bg_url: "/images/bg-gartoll.webp",
    },
    {
        nombre: "Gartoll",
        puesto: "Front-End Developer",
        duration: "Feb 2022 - Jun 2024",
        current: false,
        description:
            "I built and maintained the corporate website of a private security company, turning designs into a fast, accessible and fully responsive interface, and keeping its content up to date.",
        highlights: ["Astro", "TypeScript", "Tailwind", "Responsive"],
        url: "https://gartoll-seguridad.com",
        logo: "/images/gartoll-logo.webp",
        icon: null,
        bg_url: "/images/bg-2.webp",
    },
];
---

<section class="mt-64 lg:my-20">
    <HeadingText
        title="Experience"
        subtitle="I have worked on projects for companies such as..."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-12">
        {
            EXPERIENCE.map((item, index) => (
                <article
                    class="exp-reveal h-full"
                    style={`--delay: ${index * 150}ms`}
                >
                    <div class="exp-card group relative isolate flex h-full flex-col overflow-hidden rounded-3xl border border-white/10 p-8 lg:p-10 transition-[transform,border-color] duration-500 ease-out hover:-translate-y-2 hover:border-white/20">
                        {/* Background image + gradient */}
                        <div class="absolute inset-0 z-0 overflow-hidden rounded-3xl">
                            <img
                                src={`${item.bg_url}`}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                                class="h-full w-full scale-105 object-cover opacity-30 transition-transform duration-[1200ms] ease-out group-hover:scale-125"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/90 to-neutral-950/50" />
                        </div>

                        {/* Cursor spotlight */}
                        <div class="exp-spotlight absolute inset-0 z-[1] rounded-3xl" />

                        {/* Diagonal shine on hover */}
                        <div class="exp-shine absolute inset-0 z-[1] rounded-3xl" />

                        <div class="relative z-10 flex h-full flex-col">
                            <header class="flex items-start justify-between gap-4">
                                <div class="exp-logo flex size-16 items-center justify-center rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm transition-all duration-500 group-hover:border-secondary/40 group-hover:bg-white/10">
                                    {item.logo && (
                                        <img
                                            src={`${item.logo}`}
                                            alt={`${item.nombre} logo`}
                                            class="size-10 object-contain"
                                        />
                                    )}
                                    {item.icon && (
                                        <item.icon
                                            class="text-lg px-2 py-1"
                                            classDiv=""
                                        />
                                    )}
                                </div>

                                <span class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/70 backdrop-blur-sm">
                                    {item.current && (
                                        <span class="exp-dot relative flex size-2">
                                            <span class="absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75" />
                                            <span class="relative inline-flex size-2 rounded-full bg-secondary" />
                                        </span>
                                    )}
                                    {item.duration}
                                </span>
                            </header>

                            <div class="mt-8 flex-1">
                                <p class="text-xs uppercase tracking-[0.25em] text-secondary/80">
                                    {item.nombre}
                                </p>
                                <h3 class="mt-2 text-3xl lg:text-4xl text-white">
                                    {item.puesto}
                                </h3>

                                <span class="exp-line mt-4 block h-px w-12 bg-gradient-to-r from-secondary to-transparent" />

                                <p class="mt-5 text-[15px] leading-relaxed text-white/70 transition-colors duration-500 group-hover:text-white/90">
                                    {item.description}
                                </p>

                                <ul class="mt-6 flex flex-wrap gap-2">
                                    {item.highlights.map((tag, i) => (
                                        <li
                                            class="exp-chip rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/70"
                                            style={`--chip-delay: ${i * 70}ms`}
                                        >
                                            {tag}
                                        </li>
                                    ))}
                                </ul>
                            </div>

                            <a
                                href={`${item.url}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex w-fit items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-5 py-2.5 text-sm font-medium text-secondary transition-colors duration-300 hover:bg-secondary hover:text-neutral-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                            >
                                Visit {item.nombre}
                                <Link class="exp-arrow size-4" />
                            </a>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    /* --- Scroll entrance --- */
    .exp-reveal {
        opacity: 0;
        transform: translateY(45px) scale(0.97);
        transition:
            opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--delay, 0ms);
    }

    .exp-reveal.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    /* --- Cursor spotlight --- */
    .exp-spotlight {
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s ease;
        background: radial-gradient(
            420px circle at var(--mx, 50%) var(--my, 50%),
            rgba(203, 255, 77, 0.16),
            transparent 60%
        );
    }

    .exp-card:hover .exp-spotlight {
        opacity: 1;
    }

    /* --- Diagonal shine --- */
    .exp-shine {
        pointer-events: none;
        background: linear-gradient(
            115deg,
            transparent 35%,
            rgba(255, 255, 255, 0.08) 48%,
            rgba(203, 255, 77, 0.12) 52%,
            transparent 65%
        );
        transform: translateX(-130%);
        transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .exp-card:hover .exp-shine {
        transform: translateX(130%);
    }

    /* --- Growing accent line --- */
    .exp-line {
        transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .exp-card:hover .exp-line {
        width: 100%;
    }

    /* --- Logo --- */
    .exp-card:hover .exp-logo {
        transform: translateY(-3px) rotate(-4deg);
    }

    /* --- Staggered chips --- */
    .exp-chip {
        transition:
            transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
            color 0.35s ease,
            border-color 0.35s ease,
            background-color 0.35s ease;
        transition-delay: var(--chip-delay, 0ms);
    }

    .exp-card:hover .exp-chip {
        transform: translateY(-4px);
        color: #cbff4d;
        border-color: rgba(203, 255, 77, 0.35);
        background-color: rgba(203, 255, 77, 0.08);
    }

    /* --- Link arrow --- */
    .exp-arrow {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .exp-card:hover .exp-arrow {
        transform: translate(3px, -3px);
    }

    /* --- "Current job" dot --- */
    .exp-dot > span:first-child {
        animation: exp-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes exp-ping {
        75%,
        100% {
            transform: scale(2.4);
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .exp-reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .exp-shine,
        .exp-spotlight {
            display: none;
        }

        .exp-card,
        .exp-line,
        .exp-chip,
        .exp-logo,
        .exp-arrow,
        .exp-dot > span:first-child {
            transition: none;
            animation: none;
        }
    }
</style>

<script>
    const cards = document.querySelectorAll<HTMLElement>(".exp-card");
    const reveals = document.querySelectorAll<HTMLElement>(".exp-reveal");

    // Spotlight follows the cursor inside each card
    cards.forEach((card) => {
        card.addEventListener("pointermove", (event) => {
            const { left, top } = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${event.clientX - left}px`);
            card.style.setProperty("--my", `${event.clientY - top}px`);
        });
    });

    // Staggered reveal on scroll
    if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                });
            },
            { threshold: 0.2, rootMargin: "0px 0px -60px 0px" },
        );

        reveals.forEach((el) => observer.observe(el));
    } else {
        reveals.forEach((el) => el.classList.add("is-visible"));
    }
</script>
