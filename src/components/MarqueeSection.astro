---
export const TECNOLOGIES = [
    {
        name: "Javascript",
        src: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR09-LVBwCm3Ge2T9lmYQi1PXULql89DIGpelFz1-aT5Q&s",
    },

    {
        name: "TypeScript",
        src: "https://upload.wikimedia.org/wikipedia/commons/4/4c/Typescript_logo_2020.svg",
    },
    {
        name: "React",
        src: "https://upload.wikimedia.org/wikipedia/commons/a/a7/React-icon.svg",
    },
    {
        name: "Vue",
        src: "../../public/images/vuejs_logo.svg",
    },
    {
        name: "NextJS",
        src: "https://www.svgrepo.com/show/354113/nextjs-icon.svg",
    },
    {
        name: "TailwindCSS",
        src: "../../public/images/tailwindcss.svg",
    },
    {
        name: "HTML5",
        src: "https://upload.wikimedia.org/wikipedia/commons/6/61/HTML5_logo_and_wordmark.svg",
    },
    {
        name: "SASS",
        src: "https://www.svgrepo.com/show/374061/sass.svg",
    },
    {
        name: "PostgresSQL",
        src: "https://www.postgresql.org/media/img/about/press/elephant.png",
    },
    {
        name: "CSS",
        src: "../../public/images/CSS_logo.svg",
    },
    {
        name: "NodeJS",
        src: "../../public/images/nodejs-logo.svg",
    },
    {
        name: "AstroJS",
        src: "../../public/images/astro.svg",
    },
];
---

<div
    class="w-full inline-flex flex-nowrap overflow-hidden mt-10 bg-white/5 py-10 rounded-2xl [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-200px),transparent_100%)]"
>
    <ul
        class="flex items-center justify-center md:justify-start [&_li]:mx-8 [&_img]:max-w-none animate-infinite-scroll"
    >
        {
            TECNOLOGIES.map((item) => (
                <li>
                    <img
                        src={`${item.src}`}
                        alt={`imagen de ${item.name}`}
                        class="h-10 lg:h-14 w-auto grayscale hover:grayscale-0 transition"
                    />
                </li>
            ))
        }
    </ul>
    <ul
        class="flex items-center justify-center md:justify-start [&_li]:mx-8 [&_img]:max-w-none animate-infinite-scroll"
        aria-hidden="true"
    >
        {
            TECNOLOGIES.map((item) => (
                <li>
                    <img
                        src={`${item.src}`}
                        alt={`imagen de ${item.name}`}
                        class="h-10 lg:h-14 w-auto grayscale hover:grayscale-0 transition"
                    />
                </li>
            ))
        }
    </ul>
</div>
