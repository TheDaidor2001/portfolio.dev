---
import HeadingText from "./HeadingText.astro";
import { TITULOS } from "../data/titulos";
import { getLocale } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale).certificates;
---

<section class="my-20">
    <HeadingText title={t.title} subtitle={t.subtitle} />
    <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-x-10 gap-y-5 justify-center items-center"
    >
        {
            TITULOS.map((titulo) => (
                <article class="mt-10 hover:scale-105 transition-transform">
                    <h2 class="text-xl my-2">{titulo.title[locale]}</h2>
                    <img
                        src={`${titulo.image}`}
                        alt={t.alt(titulo.title[locale])}
                        loading="lazy"
                    />
                </article>
            ))
        }
    </div>
</section>
