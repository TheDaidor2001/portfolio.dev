---
import HeadingText from "./HeadingText.astro";
import { getLocale } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale).contact;
---

<section class="my-24">
    <HeadingText title={t.title} subtitle={t.subtitle} />

    <div class="mt-10 flex justify-center">
        <a
            href="mailto:danielcastillobalboa@gmail.com"
            class="text-secondary border w-full px-20 text-center md:w-auto lg:px-28 py-4 text-lg font-semibold rounded-2xl border-secondary hover:text-gray-950 hover:bg-secondary transition-colors duration-100"
            >{t.cta}</a
        >
    </div>
</section>
