---
import HeadingText from "./HeadingText.astro";
import Link from "./icons/Link.astro";
import { PROYECTOS } from "../data/proyectos";
import { getLocale } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale).projects;
---

<section class="my-20">
    <HeadingText title={t.title} subtitle={t.subtitle} />

    <div class="space-y-5">
        {
            PROYECTOS.map((proyecto) => (
                <article class="grid grid-cols-1 lg:grid-cols-2 items-center gap-10 lg:gap-14 bg-white/10 rounded-xl py-12 px-8 lg:py-16 lg:px-14 mt-10 group hover:scale-[1.03] lg:hover:bg-white/90 transition-all overflow-hidden">
                    <div>
                        <div class="flex gap-5 items-center justify-center lg:justify-start">
                            <h3 class="text-center lg:text-left font-bold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl lg:group-hover:text-gray-950">
                                {proyecto.title}
                            </h3>
                            <div class="hidden lg:block shrink-0">
                                <a
                                    href={`${proyecto.link}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <Link class="size-14 text-gray-950 bg-secondary rounded-full lg:block p-2 scale-0 transition-transform group-hover:scale-100" />
                                </a>
                            </div>
                        </div>
                        <p class="text-center lg:text-left text-white/80 text-md lg:text-lg lg:group-hover:text-gray-950">
                            {proyecto.description[locale]}
                        </p>
                        <div class="flex items-center justify-center lg:justify-start mt-10 gap-3">
                            {proyecto.technologies.map((item) => (
                                <img
                                    src={`/images/${item}.svg`}
                                    alt=""
                                    class="w-7 h-auto"
                                />
                            ))}
                            <a
                                href={`${proyecto.link}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Link class="size-10 text-gray-950 bg-secondary rounded-full block  p-2 lg:hidden" />
                            </a>
                        </div>
                    </div>
                    <div class="relative w-[85%] mx-auto aspect-[4/3]">
                        <img
                            src={`${proyecto.image}`}
                            alt={t.desktopAlt(proyecto.title)}
                            loading="lazy"
                            class="absolute inset-0 h-full w-full object-contain hidden lg:block lg:group-hover:scale-90 lg:group-hover:opacity-0 transition-all duration-500 ease-in-out"
                        />
                        <img
                            src={`${proyecto.image2}`}
                            alt={t.mobileAlt(proyecto.title)}
                            loading="lazy"
                            class="absolute inset-0 h-full w-full object-contain scale-125 lg:opacity-0 lg:group-hover:scale-[1.35] lg:group-hover:opacity-100 transition-all duration-500 ease-in-out"
                        />
                    </div>
                </article>
            ))
        }
    </div>
</section>
